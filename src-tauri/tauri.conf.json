{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitDesk",
  "version": "0.1.0",
  "identifier": "com.gitdesk.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5183",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GitDesk",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 620,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "轻量 Git 图形客户端",
    "longDescription": "GitDesk 是一个面向 Windows 的轻量 Git 图形客户端：提交图、diff、hunk 级暂存，并把每条等价的 git 命令原样展示出来。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
